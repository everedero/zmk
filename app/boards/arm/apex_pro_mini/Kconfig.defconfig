if BOARD_APEX_PRO_MINI

config BOARD
	default "apex_pro_mini"

config ZMK_KEYBOARD_NAME
    default "Apex Pro Mini"

config ZMK_KSCAN_MATRIX_POLLING
    default y

config SPI_STM32_INTERRUPT
	default y
	depends on SPI

endif # BOARD_APEX_PRO_MINI
